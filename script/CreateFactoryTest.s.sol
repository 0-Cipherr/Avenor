contract CreateFactoryTest is Script {
    CREATE3FACTORY public factory;

    function setUp() public {}
    ///left off deployinon another chain making sure address is the same
    function run() public {
        vm.startBroadcast();
        bytes32 salt = vm.parseBytes32(
            "0x6893c03563a9df9df1226adf799129cb0bab607e5aae7c152a20d11f6a1672dc"
        );
        bytes memory creationCode = vm.parseBytes(
            ""
        );
        deployFactory(salt, creationCode, false);
        vm.stopBroadcast();
    }

    function generateDynamicSalt(
        string memory name,
        uint256 id
    ) public pure returns (bytes32) {
        return keccak256(abi.encodePacked(name, id));
    }

    function deployFactory(
        bytes32 __salt,
        bytes memory __creationCode,
        bool isNew
    ) public {
        /**checks if values are not null with .length  funciton and we validate if factory
         *  is or not deployed
         *   */
        if (isNew) {
            factory = new CREATE3FACTORY();

            console.log("False");
            bytes memory _creationCode;
            bytes32 _salt = generateDynamicSalt("Vault", 2);

            _creationCode = type(CREATE3FACTORY).creationCode;

            /**
             * FOR _creationcode:
             * deployment provides these 4 values importat <init code> <runtime code> <constructor parameters>
             * to create the create3 function we must privde salt and creation code
             *  salt is any custom value u wanna generate but must be unique otherwise can cause coflict among users on the contract level
             * creation code however must be preciesly the creation code of the deployed contract
             * (reason prvide...)
             */
            (address deployed) = factory.deploy(_salt, _creationCode);

            console.log("Chain Deployed:");
            console.logUint(block.chainid);
            console.log("Factory deployed creation code: ");
            console.logBytes(_creationCode);
            console.log("Factory deployed salt: ");
            console.logBytes32(_salt);
            console.log("Factory address raw: ", address(factory));
            console.log("Deterministic address deployed: ");
            console.logAddress(deployed);
            console.log("Raw address deployed: ");
            console.logAddress(address(factory));
        }
        if (isNew == false) {
            factory = new CREATE3FACTORY();

            (address deployed) = factory.deploy(__salt, __creationCode);
            factory = CREATE3FACTORY(deployed); //assigning deployed deterministic address on hub chain

            ///// @title A title that should describe the contract/interface
            /// @author The name of the author
            /// @notice Explain to an end user what this does
            /// @dev Explain to a developer any extra details
        }
    }

    /**CHecks f vault and salt is not null ("") */
    function verifySaltCCode() public returns (bool) {}

    function cloneAddress() public {}
}
