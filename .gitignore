# ==========================================
# 1. Compiler Files & Build Artifacts
# ==========================================
/out/
/cache/

# ==========================================
# 2. Foundry Script Broadcasts & Logs
# ==========================================
# Keep the folder structure but ignore specific network/dry-run logs
!/broadcast/
/broadcast/*/31337/
/broadcast/**/dry-run/

# ==========================================
# 3. Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
config.json

# Crypto keys and certificates
id_rsa
*.pem
*.key

# ==========================================
# 4. Dependencies
# ==========================================
# Uncomment the line below if you do not track lib submodules explicitly
# lib/

# ==========================================
# 5. IDE, Editors, and OS Files
# ==========================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ==========================================
# 6. Miscellaneous & Documentation
# ==========================================
.logs/
.ignore/
docs/
# Tools and Dependency Caches
.deps/
.wake/
